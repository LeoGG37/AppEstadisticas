# Copia este archivo como secrets.toml y rellena los valores
# NUNCA subas secrets.toml a GitHub (ya está en .gitignore)

# Contraseña de acceso a la app
app_password = "elige-una-contraseña-aqui"

[enable_banking]
application_id = "tu-application-id-aqui"
private_key = """
-----BEGIN PRIVATE KEY-----
(contenido del archivo .pem descargado de Enable Banking)
-----END PRIVATE KEY-----
"""

# Estos valores se obtienen desde la pestaña "Conexión" de la app,
# después de autorizar el acceso en el banco.
session_id = "se-obtiene-al-autorizar"
account_uid = "se-obtiene-al-autorizar"
